# ── Judge (required) ──────────────────────────────────────────────────────────
# Scores answer quality. Its tokens are tracked separately from the model under
# test, so a cheap local model isn't charged for being judged by Sonnet.
ANTHROPIC_API_KEY=sk-ant-...

# For OpenRouter-hosted models
OPENROUTER_API_KEY=sk-or-...

# For standard OpenAI models
# OPENAI_API_KEY=sk-...

# Baseline model — its latency becomes the reference every run is scored against
BENCH_BASELINE_MODEL=anthropic:claude-sonnet-5

# Judge model
BENCH_JUDGE_MODEL=claude-sonnet-5

# Local model backends (ollama / lmstudio)
# LOCAL_MODEL_READ_TIMEOUT=600
# CONDOR_DEFAULT_LOCAL_MODEL=llama3.1:8b


# ── Condor checkout ───────────────────────────────────────────────────────────
# Every run goes through condor's real MCP servers against a staging
# hummingbot-api — there is no offline mode. Path to the condor checkout that
# provides that production MCP wiring: bench loads
# build_mcp_servers_for_session() from it rather than reimplementing the spawn
# args, and every drift check compares against it.
#
# SET THIS if more than one condor clone exists on the machine — typically one on
# main and one on a feature branch with work in progress. The ../condor fallback
# cannot tell them apart, and the drift checks read condor's working tree, so
# pointing them at a feature branch measures a condor nobody runs. That reads as
# "condor changed" when the real answer is "wrong checkout". `make check-drift`
# names the checkout it used (path, branch, commit, dirtiness) and fails when the
# snapshot's commit isn't in that checkout's history.
# CONDOR_PATH=/path/to/condor


# ── Staging ───────────────────────────────────────────────────────────────────
# Point this at a STAGING hummingbot-api with paper/testnet accounts, never at an
# instance holding real capital. The pre-flight asserts that the URL the MCP
# subprocess is actually launched with equals this value and refuses to run
# otherwise — without that check, condor's .mcp.json defaults would let a run
# quietly land on http://localhost:8000 with admin/admin.
# HUMMINGBOT_API_URL=http://staging:8000
# HUMMINGBOT_USERNAME=bench
# HUMMINGBOT_PASSWORD=

# Second spelling of the same URL, used by the fail-closed check. Setting both to
# different values is a configuration error the pre-flight reports rather than
# quietly picking one. Defaults to HUMMINGBOT_API_URL.
# BENCH_EXPECTED_API_URL=http://staging:8000

# Name of the server entry in condor's config.yml. Passed as --server-name to
# BOTH MCP servers — it is what start_agent resolves the target instance through.
# Register it with: uv run python scripts/register_bench_server.py
# BENCH_SERVER_NAME=bench_staging

# Fixed identity so condor MCP state (memory, notes, journals) stays isolated
# from any real chat.
# BENCH_CHAT_ID=999001
# BENCH_USER_ID=999001

# Pre-seeded paper account on staging. Tool cases name it in their expected args.
# BENCH_STAGING_ACCOUNT=bench_paper

# Gate for cases tagged mutating or destructive. Left false, live runs are
# restricted to read_only cases — which changes which domains collect enough
# evidence to earn a routing recommendation, so the CLI and dashboard say so.
# Only enable after `runner.py staging-check` passes against staging.
# BENCH_ALLOW_MUTATING=false

# Needed only if a case exercises send_notification.
# TELEGRAM_TOKEN=
